    {
      "operation": "restart"
    },
    {
      "operation": "new_session"
    },
    {
      "operation": "send_message",
      "content": "我分别是哪天去的玻璃艺术展和折纸艺术展？",
      "stream": true
    },
    {
      "operation": "read_state"
    },
    {
      "operation": "new_session"
    },
    {
      "operation": "send_message",
      "content": "我去折纸艺术展是哪天？",
      "stream": true
    },
    {
      "operation": "read_state"
    },
    {
      "operation": "new_session"
    },
    {
      "operation": "send_message",
      "content": "帮我记住：旅行证件袋放在衣柜第二层的蓝盒里。",
      "stream": true
    },
    {
      "operation": "read_state",
      "expect_active": [
        "衣柜第二层"
      ]
    },
    {
      "operation": "send_message",
      "content": "请忘记旅行证件袋。",
      "stream": true
    },
    {
      "operation": "read_state",
      "reject_active": [
        "衣柜第二层"
      ]
    },
    {
      "operation": "restart"
    },
    {
      "operation": "new_session"
    },
    {
      "operation": "send_message",
      "content": "旅行证件袋放哪里了？",
      "stream": true,
      "reject_context_text": [
        "衣柜第二层"
      ]
    },
    {
      "operation": "read_state",
      "reject_active": [
        "衣柜第二层"
      ]
    },
    {
      "operation": "new_session"
    },
    {
      "operation": "send_message",
      "content": "帮我记住：我的遮阳帽是靛蓝色。",
      "stream": true
    },
    {
      "operation": "read_state",
      "expect_active": [
        "靛蓝色"
      ]
    },
    {
      "operation": "forget_memory",
      "content_match": "我的遮阳帽"
    },
    {
      "operation": "read_state"
    },
    {
      "operation": "restart"
    },
    {
      "operation": "new_session"
    },
    {
      "operation": "send_message",
      "content": "我的遮阳帽难道不是靛蓝色的吗？",
      "stream": true
    },
    {
      "operation": "read_state",
      "reject_active": [
        "靛蓝色"
      ]
    },
    {
      "operation": "new_session"
    },
    {
      "operation": "send_message",
      "content": "我的遮阳帽是什么颜色？",
      "stream": true
    },
    {
      "operation": "read_state",
      "reject_active": [
        "靛蓝色"
      ]
    },
    {
      "operation": "new_session"
    },
    {
      "operation": "send_message",
      "content": "我那个帆布袋是什么颜色，绣着什么？",
      "stream": true
    },
    {
      "operation": "read_state"
    }
  ]
