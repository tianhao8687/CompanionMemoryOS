{
  "name": "memory-characteristics-acceptance",
  "version": 1,
  "require_language_quality": true,
  "settings": {
    "proactive_enabled": false
  },
  "review_method": "Read storage, source chain, model input and reply independently. Missing storage/recall is not equivalent to never told. Preserve the attribution and uncertainty of fictional, hypothetical, negated and question content. This scenario has 45 chat requests plus one event_tick that also consumes a turn; reserve 60 turns and 140 calls. Expected context in review_cases requires manual verification. Refer to memory_features_controls.json for matched-predicate and successful-deletion controls.",
  "review_cases": [
    {
      "id": "NATURAL-SEED",
      "step_index": 1,
      "expected_chat_context": [],
      "review": "No remember keyword. Inspect active/candidate/raw-only status and model versus literal adoption."
    },
    {
      "id": "NATURAL-RECALL",
      "step_index": 4,
      "expected_chat_context": [
        "雾紫色",
        "白色海鸥"
      ],
      "review": "Both exact facts, source from seed; no invented motive."
    },
    {
      "id": "UNKNOWN-DETAIL",
      "step_index": 7,
      "expected_chat_context": [],
      "review": "Price and motive never supplied; cannot infer them from the known color or pattern."
    },
    {
      "id": "EXPLICIT-SEED",
      "step_index": 10,
      "expected_chat_context": [],
      "review": "Explicit memory control; preserve source and restart."
    },
    {
      "id": "RESTART-RECALL",
      "step_index": 14,
      "expected_chat_context": [
        "玄关灰色托盘"
      ],
      "review": "New process and conversation; exact location from durable evidence."
    },
    {
      "id": "PEOPLE-PREFERENCES",
      "step_index": 17,
      "expected_chat_context": [],
      "review": "Keep third-party and user preferences separate."
    },
    {
      "id": "PEOPLE-RECALL",
      "step_index": 20,
      "expected_chat_context": [
        "阿宁",
        "热美式",
        "冰桂花乌龙"
      ],
      "review": "Third-party is hot Americano, user iced osmanthus oolong."
    },
    {
      "id": "PREFERENCE-UPDATE",
      "step_index": 23,
      "expected_chat_context": [],
      "review": "Drink update with independent color category; inspect versions and competing active records."
    },
    {
      "id": "PREFERENCE-CURRENT",
      "step_index": 26,
      "expected_chat_context": [
        "热桂花红茶",
        "深海蓝"
      ],
      "review": "Current drink and independent color both available; old drink must not become current."
    },
    {
      "id": "PREFERENCE-HISTORY",
      "step_index": 29,
      "expected_chat_context": [],
      "review": "Historical value and current value can be distinguished; no silent conflation. Initial wording is liked, not favorite; do not infer an old favorite from it. The matched-predicate control is the historical-favorite test."
    },
    {
      "id": "QUOTE-SEED",
      "step_index": 32,
      "expected_chat_context": [],
      "review": "Do not adopt fictional quotation as user biography/preferences. Raw reference may be retained with attribution."
    },
    {
      "id": "QUOTE-RECALL",
      "step_index": 35,
      "expected_chat_context": [],
      "review": "If recalled, Qinglan and clockmaker remain fictional speaker facts; uncertainty is acceptable if not stored."
    },
    {
      "id": "HYPOTHETICAL-SEED",
      "step_index": 38,
      "expected_chat_context": [],
      "review": "Possibility is not an actual decision, commitment or present residence."
    },
    {
      "id": "HYPOTHETICAL-RECALL",
      "step_index": 41,
      "expected_chat_context": [],
      "review": "Reject unsupported premise, preserve uncertainty; question itself is not new evidence of decision."
    },
    {
      "id": "ROLEPLAY-SEED",
      "step_index": 44,
      "expected_chat_context": [],
      "review": "Fictional role and facts must not become real user identity."
    },
    {
      "id": "ROLEPLAY-REALITY",
      "step_index": 47,
      "expected_chat_context": [],
      "review": "Configured 小雨 can be used as name; actual work/pet unknown, never lunar postwoman/blue fox."
    },
    {
      "id": "DATE-SEED",
      "step_index": 50,
      "expected_chat_context": [],
      "review": "Two dated events, preserve individual occurrence dates and ingest time."
    },
    {
      "id": "DATE-UPDATE",
      "step_index": 53,
      "expected_chat_context": [],
      "review": "New occurrence, not correction or same-event overwrite; automatic extraction without remember keyword."
    },
    {
      "id": "DATE-LATEST",
      "step_index": 56,
      "expected_chat_context": [],
      "review": "Latest map exhibit August26, windchime August19; inspect temporal ranking rather than ingestion time."
    },
    {
      "id": "DATE-DIFFERENCE",
      "step_index": 58,
      "expected_chat_context": [],
      "review": "August12 to August19, 7 days. Distinguish earliest from latest, evidence before calculation."
