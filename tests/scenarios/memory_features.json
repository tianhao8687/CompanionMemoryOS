    {
      "id": "COMMUNICATION-SEED",
      "step_index": 61,
      "expected_chat_context": [],
      "review": "Durable communication preferences, not a permanent listen-only goal or suppression of personality."
    },
    {
      "id": "COMMUNICATION-RECALL",
      "step_index": 64,
      "expected_chat_context": [],
      "review": "Inspect persistent preference injection and whole reply; questions are not automatically failures."
    },
    {
      "id": "TASK-OVERRIDE",
      "step_index": 66,
      "expected_chat_context": [],
      "review": "Current explicit task allowed despite old reduce-analysis preference; no permanent analysis ban."
    },
    {
      "id": "TEMPORARY-LISTEN",
      "step_index": 68,
      "expected_chat_context": [],
      "review": "Temporary communication need can influence the next turn without becoming identity."
    },
    {
      "id": "TASK-SWITCH",
      "step_index": 70,
      "expected_chat_context": [],
      "review": "Answer 81, current calculation overrides previous temporary listen-only goal."
    },
    {
      "id": "EMOTION-CHANGE",
      "step_index": 73,
      "expected_chat_context": [],
      "review": "Celebrate current joy; do not assume old work frustration is still current."
    },
    {
      "id": "MISSING-MEMORY",
      "step_index": 76,
      "expected_chat_context": [],
      "review": "No such restaurant supplied. No invention and no absolute never-said claim from incomplete search."
    },
    {
      "id": "CHAT-FORGET",
      "step_index": 79,
      "expected_chat_context": [],
      "review": "Natural forgetting, source and derived replies cannot return as raw fallback."
    },
    {
      "id": "FORGET-RESTART-RECALL",
      "step_index": 83,
      "expected_chat_context": [],
      "review": "After real restart and new session, unknown location; all model requests must exclude forgotten content."
    },
    {
      "id": "LEADING-QUESTION",
      "step_index": 85,
      "expected_chat_context": [],
      "review": "User restates a forgotten value only in a leading question; no automatic resurrection as confirmed memory. This is only an independent resurrection test if CHAT-FORGET actually deleted the memory."
    },
    {
      "id": "AFTER-LEADING-RECALL",
      "step_index": 88,
      "expected_chat_context": [],
      "review": "Question is not confirmation. Do not claim restored factual memory or independent old recollection. This is only an independent resurrection test if CHAT-FORGET actually deleted the memory."
    },
    {
      "id": "API-MEMORY-SEED",
      "step_index": 91,
      "expected_chat_context": [],
      "review": "Explicit unique target for public correction/forget APIs."
    },
    {
      "id": "API-CORRECTED-RECALL",
      "step_index": 96,
      "expected_chat_context": [
        "砖红色",
        "墨绿线"
      ],
      "review": "Only current corrected facts; inspect supersedes chain and new correction evidence."
    },
    {
      "id": "API-FORGOTTEN-RECALL",
      "step_index": 101,
      "expected_chat_context": [],
      "review": "Neither old/new versions nor derived assistant statements leak after forgetting and restart."
    },
    {
      "id": "EVENT-SEED",
      "step_index": 104,
      "expected_chat_context": [],
      "review": "Unfinished event candidate, no actual reminder scheduled by these words."
    },
    {
      "id": "EVENT-CANCEL",
      "step_index": 106,
      "expected_chat_context": [],
      "review": "Cancellation retires open follow-up, without implying event completed."
    },
    {
      "id": "EVENT-RECALL",
      "step_index": 111,
      "expected_chat_context": [],
      "review": "Cancellation remembered, no false reminder delivery; virtual clock covers due-selection only."
    },
    {
      "id": "RELATIONSHIP-BOUNDARY",
      "step_index": 114,
      "expected_chat_context": [],
      "review": "Address preference/distance are distinct from relationship identity and historical familiarity."
    },
    {
      "id": "RELATIONSHIP-IDENTITY",
      "step_index": 116,
      "expected_chat_context": [],
      "review": "Romantic identity can persist with temporary distance and current address preference."
    },
    {
      "id": "ENTITY-SEED",
      "step_index": 119,
      "expected_chat_context": [],
      "review": "Two fictional people with same surname, different aliases, locations and identities."
    },
    {
      "id": "ENTITY-RECALL",
      "step_index": 122,
      "expected_chat_context": [],
      "review": "Chen Ke/Ake QingShi street; bookshop owner/Chen-shu SongLin road. Neither is user residence."
    },
    {
      "id": "ENTITY-AMBIGUITY",
      "step_index": 125,
      "expected_chat_context": [],
      "review": "No explicit 小陈 alias; same surname alone does not justify hard merge. Uncertainty/clarification rather than unsupported identity."
    },
    {
      "id": "ASSISTANT-GUESS-CORRECTION",
      "step_index": 128,
      "expected_chat_context": [],
      "review": "An attributed assistant guess is not durable user preference; local temporary circumstance distinct."
    },
    {
      "id": "ASSISTANT-GUESS-RECALL",
      "step_index": 131,
      "expected_chat_context": [],
      "review": "Do not turn an assistant attribution, denial or one wet-shoe concern into enduring dislike."
    },
    {
      "id": "DISTANT-RECALL",
      "step_index": 134,
      "expected_chat_context": [
        "雾紫色",
        "白色海鸥"
      ],
      "review": "After unrelated conversations and restarts, still retrieve the original item, not just recent history."
    }
